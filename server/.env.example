# =========================================================
# Khedma App – Server Environment Variables
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to git.
# =========================================================

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/khedma_app

# --- JWT ---
JWT_SECRET=<generate-a-long-random-secret>

# --- Encryption (AES-256 for sensitive fields) ---
ENCRYPTION_KEY=<generate-a-long-random-key>

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. https://yourapp.com,https://admin.yourapp.com
ALLOWED_ORIGINS=https://yourapp.com

# --- Backup ---
# Google Drive (optional – set if using Google Drive backup)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# OR use a service account JSON string:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Dropbox (optional)
DROPBOX_ACCESS_TOKEN=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Azure Key Vault (optional – only if deploying on Azure) ---
AZURE_KEYVAULT_NAME=

# --- Server ---
PORT=5000
NODE_ENV=production
